# Environment Variables for Rudra's Portfolio
# Copy this file to .env and fill in your values. Never commit real secrets.

# ---- Frontend ----

# Backend API URL (where Express server runs)
VITE_API_URL=http://localhost:5000

# EmailJS Configuration (from emailjs.com dashboard)
VITE_EMAILJS_SERVICE_ID=service_default
VITE_EMAILJS_TEMPLATE_ID=template_portfolio
VITE_EMAILJS_PUBLIC_KEY=user_placeholder

# Optional: personal GitHub token to raise the public API rate limit
# VITE_GITHUB_TOKEN=

# ---- Backend (create backend/.env with these) ----

# MongoDB connection string
# MONGODB_URI=mongodb://127.0.0.1:27017/portfolioDB

# Server port
# PORT=5000

# Frontend URL for CORS
# CLIENT_URL=http://localhost:3000

# JWT secret key (use a strong random string in production)
# JWT_SECRET=your_jwt_secret_key_change_in_production

# Optional: Google OAuth Client ID (only needed if you enable Google sign-in
# in addition to the default email + password auth)
# GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
